ANTHROPIC_API_KEY=your-api-key-here
# Optional: override the model
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Fal AI key for /api/reference (https://fal.ai/dashboard/keys)
FAL_KEY=your-fal-key-here
# Optional: override the image model
# FAL_MODEL=fal-ai/flux/schnell

# Optional: the Claude model and effort that write image prompts for /api/reference
# PLANNER_MODEL=claude-opus-5-5
# PLANNER_EFFORT=low
# Optional: effort for writing tutorial step text
# TUTORIAL_EFFORT=low

# Deployment
# Backend (Render): comma-separated origins allowed to call the API; "*" if unset
# ALLOWED_ORIGINS=https://your-project.vercel.app
# Frontend (Vercel): URL of the Render backend, written into config.js at build time
# API_BASE=https://your-service.onrender.com
